# PostgreSQL Datenbank-Verbindung (DATABASE_URL)
# Option A: TCP Connection (Entwicklung)
# DATABASE_URL="postgres://postgres:dein_passwort@localhost:5432/meincms"

# Option B: Unix Domain Socket (Produktions-Server)
DATABASE_URL="postgres://postgres:dein_passwort@/var/run/postgresql/meincms"

# Webserver Modus (TCP Port vs. Unix Domain Socket)
# Option A: TCP Port (z.B. PORT=5000)
# PORT=5000

# Option B: Unix Domain Socket für NGINX / Caddy Reverse Proxy (Produktions-Server)
UNIX_SOCKET="/run/meincms/meincms.sock"

# Logging (debug, info, warn, error)
RUST_LOG="meincms_web=info,tower_http=info"
